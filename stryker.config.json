{
	"coverageAnalysis": "off",
	"mutate": ["src/**/*.ts"],
	"tsconfigFile": "tsconfig.json",
	"testRunner": "vitest",
	"concurrency": "100%",
	"timeoutMS": 30000,
	"timeoutFactor": 2,
	"ignorePatterns": ["/dist", "/coverage", "/.seeds", "/agent", "/openwiki"],
	"thresholds": {
		"high": 80,
		"low": 62,
		"break": 62
	},
	"reporters": ["clear-text", "progress", "html", "json"]
}
